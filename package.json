    "pipeline": "node server/pipeline/cli.js --config graveyard.config.json --source data",
    "demo": "node tools/demo-world.mjs",
    "screenshots": "node tools/screenshots.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@auth/core": "^0.41.3",
    "@upstash/redis": "^1.41.0",
    "@vercel/functions": "^3.11.3",
    "n8ao": "2.1.0",
    "postprocessing": "6.39.6",
    "three": "0.187.0"
  },
  "devDependencies": {
    "vite": "8.3.8"
  }
}
