{
  "name": "graveyard",
  "version": "0.1.0",
  "description": "A night-time 3D village where your GitHub repos live, sleep, linger in the hospice or rest in the graveyard.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --port 8765 --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --port 8765",
